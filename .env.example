# Базовые URL Open-Meteo
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast

# Таймаут запроса (мс)
REQUEST_TIMEOUT_MS=5000

# Каталог отчётов
REPORTS_DIR=reports

# Единицы измерения: celsius | fahrenheit
TEMPERATURE_UNIT=celsius

# Единицы осадков: mm | inch
PRECIPITATION_UNIT=mm

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance
DB_USER=maintenance
DB_PASSWORD=maintenance_secret
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
